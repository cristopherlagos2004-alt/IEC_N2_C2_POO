# Copie este archivo como .env y complete sus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore).
DB_NAME=gestion_escolar
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_escolar
DB_PASSWORD=cambiar_esta_contraseña

# Evaluación 3: llave de la API del clima (OpenWeatherMap).
# Se obtiene gratis en https://home.openweathermap.org/api_keys (32 caracteres).
# La API de indicadores (mindicador.cl) no necesita llave.
OPENWEATHER_API_KEY=cambiar_esta_llave
